# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.tmp

# Build / dist
build/
dist/
*.egg

# But the gallery/build/ image folder is source content, not a Python build artifact
!docs/gallery/build/

# Generated render outputs (regenerable from source)
renders/*.png
models/*.step
models/*.stl
models/*.3mf
models/*.wrl
models/*.vrml
models/*.tjs

# Keep the viewer.html + STL in git (those are useful static assets)
!renders/viewer.html
!renders/wattplot_v2.stl

# Local env / secrets
.env
.env.local
*.local

# ESPHome secrets (template is committed as secrets.yaml.example)
firmware/secrets.yaml
firmware/secrets.yaml.*
!firmware/secrets.yaml.example

# Test artifacts
.coverage
.pytest_cache/
test_output/
tools/ci_jobs*.json
models/*.FCBak

# Runtime logs from tools/log_subscriber.py (wattplot.log grows to
# hundreds of MB — never commit these; docs/logging.md explains rotation)
logs/
*.log
*.log.gz
!analysis/*.md

# ESPHome build/validate transcripts (firmware/.esphome/ is covered by
# firmware/.gitignore; these loose per-run logs were not)
firmware/.esphome_*.log

# Scratch files from doc/site generation (tools/*.ps1 splice these into
# the HTML pages; they are intermediates, not sources)
tools/_sim_*.html
tools/sim_body.html
tools/sim_inline_*.html

# Draft commit messages staged for `git commit -F`
tools/commit_msg_*.txt

# Vendor reference PDFs (datasheets, application notes). Per-person
# references; the canonical "where to download" list is in
# models/freecad/parts/vendor/README.md.
parts/
# ...except the OpenSCAD per-part modules under models/openscad/parts/.
# Those are checked-in source files, not vendor PDFs.
!models/openscad/parts/

# SVG renders from models/render_svg_views.py (PNG renders already
# gitignored above). Small but regenerable build artifacts.
renders/*.svg
